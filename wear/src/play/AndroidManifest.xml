<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false" is already set in src/main/AndroidManifest.xml and applies here too
         via manifest merging - restated explicitly since a static analyzer (SonarCloud xml:S6358)
         checks this overlay file in isolation and can't see that inherited value. -->
    <application android:allowBackup="false">

        <!-- Receives a sign-in request pushed by the phone companion app; see companion/. Play
             flavor only - the companion pairing feature needs Google Play Services on both ends. -->
        <service
            android:name=".companion.ApiKeyMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/clockify" />
            </intent-filter>
        </service>

    </application>

</manifest>
